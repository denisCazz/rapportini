# Copia in .env o .env.local e compila i valori mancanti.
# NON committare .env con segreti reali.

APP_ENV=PROD
NEXT_PUBLIC_APP_ENV=PROD

# Database PostgreSQL proprietario
POSTGRES_HOST=212.227.193.249
POSTGRES_PORT=60001
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=rapportini_eva
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer

# Override opzionale (se impostato, ignora POSTGRES_* sopra)
# DATABASE_URL=
# DATABASE_URL_PROD=

# Auth — minimo 32 caratteri (openssl rand -base64 32)
JWT_SECRET=change-me-use-openssl-rand-base64-32-chars

# Organizzazione default (multi-tenant)
DEFAULT_ORG_ID=default
NEXT_PUBLIC_DEFAULT_ORG_ID=default

# URL pubblico app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cookie sicuri in produzione HTTPS
# FORCE_SECURE_COOKIES=true

# Stripe — abbonamenti moduli (€6/mese singolo, €19 bundle utente, primo mese gratis)
# Consigliato: restricted key (rk_test_...) invece di sk_test_...
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID (generati con: npx tsx scripts/stripe-setup-products.ts)
# STRIPE_PRICE_BUNDLE_USER=price_...
# STRIPE_PRICE_CAT_BASE=price_...
# STRIPE_PRICE_CAT_EXTRA=price_...
# STRIPE_PRICE_MODULE_PIANIFICAZIONE_INTERVENTI=price_...
# STRIPE_PRICE_MODULE_ASSEGNAZIONE_LAVORI=price_...
# STRIPE_PRICE_MODULE_NOTIFICHE_SCADENZE=price_...
# STRIPE_PRICE_MODULE_MAGAZZINO_RICAMBI=price_...
# STRIPE_PRICE_MODULE_REPORT_CLIENTE=price_...
# STRIPE_PRICE_MODULE_PREVENTIVI=price_...
# Cron promemoria scadenze (header Authorization: Bearer <CRON_SECRET>)
# CRON_SECRET=change-me-cron-secret

# Email (opzionale)
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com

# Shop ufficiale ricambi (modulo Magazzino: link ordine + "Usa nel rapportino")
NEXT_PUBLIC_RICAMBI_SHOP_URL=https://www.ricambixstufe.it

# Storage immagini rapportini (bucket filesystem: rapportini-active / rapportini-archive)
STORAGE_BASE_PATH=./data/media
# Mesi prima di spostare le foto nel bucket archivio (default 24)
RAPPORTINI_MEDIA_RETENTION_MONTHS=24

# Seed primo admin (solo setup iniziale: npm run db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ORG_NAME=EVA CALÒR
