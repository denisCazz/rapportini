# Copia in .env o .env.local e compila i valori mancanti.
# NON committare .env con segreti reali.

APP_ENV=PROD
NEXT_PUBLIC_APP_ENV=PROD

# Database PostgreSQL proprietario
POSTGRES_HOST=212.227.193.249
POSTGRES_PORT=60001
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=rapportini_eva
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer

# Override opzionale (se impostato, ignora POSTGRES_* sopra)
# DATABASE_URL=
# DATABASE_URL_PROD=

# Auth — minimo 32 caratteri (openssl rand -base64 32)
JWT_SECRET=change-me-use-openssl-rand-base64-32-chars

# Organizzazione default (multi-tenant)
DEFAULT_ORG_ID=default
NEXT_PUBLIC_DEFAULT_ORG_ID=default

# URL pubblico app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cookie sicuri in produzione HTTPS
# FORCE_SECURE_COOKIES=true

# Email (opzionale)
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com

# Storage immagini rapportini (bucket filesystem: rapportini-active / rapportini-archive)
STORAGE_BASE_PATH=./data/media
# Mesi prima di spostare le foto nel bucket archivio (default 24)
RAPPORTINI_MEDIA_RETENTION_MONTHS=24

# Seed primo admin (solo setup iniziale: npm run db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ORG_NAME=Bitora
