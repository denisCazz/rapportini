generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utenti {
  id                   String    @id @default(uuid()) @db.Uuid
  org_id               String    @default("default") @db.VarChar(100)
  username             String    @db.VarChar(255)
  password_hash        String    @db.VarChar(255)
  ruolo                String    @db.VarChar(20)
  nome                 String    @db.VarChar(255)
  cognome              String    @db.VarChar(255)
  telefono             String?   @db.VarChar(50)
  email                String?   @db.VarChar(255)
  qualifica            String?   @db.VarChar(255)
  firma                String?
  attivo               Boolean?  @default(true)
  ultimo_accesso       DateTime? @db.Timestamptz(6)
  must_change_password Boolean   @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  password_reset_tokens PasswordResetTokens[]
  rapportini            Rapportini[]
  utente_moduli         UtenteModuli[]

  @@unique([org_id, username], map: "uq_utenti_org_id_username")
  @@map("utenti")
}

model Moduli {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(64)
  nome        String    @db.VarChar(255)
  descrizione String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  utente_moduli UtenteModuli[]

  @@map("moduli")
}

model UtenteModuli {
  id         String    @id @default(uuid()) @db.Uuid
  org_id     String    @default("default") @db.VarChar(100)
  utente_id  String    @db.Uuid
  modulo_id  String    @db.Uuid
  attivo     Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  utenti Utenti @relation(fields: [utente_id], references: [id], onDelete: Cascade)
  moduli Moduli @relation(fields: [modulo_id], references: [id], onDelete: Cascade)

  @@unique([utente_id, modulo_id], map: "uq_utente_moduli_utente_modulo")
  @@index([org_id], map: "idx_utente_moduli_org_id")
  @@index([utente_id], map: "idx_utente_moduli_utente_id")
  @@map("utente_moduli")
}

model Clienti {
  id             String    @id @default(uuid()) @db.Uuid
  org_id         String    @default("default") @db.VarChar(100)
  nome           String    @db.VarChar(255)
  cognome        String    @db.VarChar(255)
  ragione_sociale String?  @db.VarChar(255)
  via            String?   @db.VarChar(255)
  numero_civico  String?   @db.VarChar(20)
  indirizzo      String    @db.VarChar(500)
  citta          String    @db.VarChar(255)
  cap            String    @db.VarChar(10)
  provincia      String?   @db.VarChar(10)
  telefono       String    @db.VarChar(50)
  email          String?   @db.VarChar(255)
  partita_iva    String?   @db.VarChar(50)
  codice_fiscale String?   @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)

  rapportini Rapportini[]

  @@unique([org_id, nome, cognome, telefono], map: "unique_cliente")
  @@map("clienti")
}

model Rapportini {
  id                  String    @id @default(uuid()) @db.Uuid
  org_id              String    @default("default") @db.VarChar(100)
  utente_id           String    @db.Uuid
  cliente_id          String    @db.Uuid
  data_richiesta      DateTime? @db.Date
  data_intervento     DateTime  @db.Date
  ora_intervento      DateTime  @db.Time(6)
  tipologia_intervento String?  @db.VarChar(50)
  tipo_stufa          String    @db.VarChar(20)
  marca               String    @db.VarChar(255)
  modello             String    @db.VarChar(255)
  numero_serie        String?   @db.VarChar(255)
  data_acquisto       DateTime? @db.Date
  rivenditore         String?   @db.VarChar(255)
  tipo_intervento     String    @db.VarChar(255)
  motivo_chiamata     String?
  codice_errore       String?   @db.VarChar(20)
  verifiche           String?
  installazione_eseguita_da String? @db.VarChar(255)
  descrizione         String
  spiegata_manutenzione String? @db.VarChar(5)
  impianto_elettrico  String?   @db.VarChar(5)
  condotto_fumi       String?   @db.VarChar(5)
  installazione_uni10683 String? @db.VarChar(5)
  controllo_parametri String?   @db.VarChar(5)
  presa_visione_condizioni_garanzia Boolean? @default(false)
  tipologia_installazione String? @db.VarChar(50)
  note_installazione  String?
  prossimo_intervento DateTime? @db.Date
  materiali_utilizzati String?
  note                String?
  firma_cliente_privacy String?
  firma_operatore     String?
  firma_cliente       String?
  data_creazione      DateTime? @default(now()) @db.Timestamptz(6)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)

  utenti  Utenti  @relation(fields: [utente_id], references: [id], onDelete: Restrict)
  clienti Clienti @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  immagini RapportinoImmagini[]

  @@index([cliente_id], map: "idx_rapportini_cliente")
  @@index([utente_id], map: "idx_rapportini_utente")
  @@index([data_intervento], map: "idx_rapportini_data")
  @@index([tipo_stufa], map: "idx_rapportini_tipo_stufa")
  @@index([org_id], map: "idx_rapportini_org_id")
  @@index([org_id, utente_id], map: "idx_rapportini_org_utente")
  @@index([org_id, data_intervento], map: "idx_rapportini_org_data")
  @@map("rapportini")
}

model RapportinoImmagini {
  id             String    @id @default(uuid()) @db.Uuid
  org_id         String    @default("default") @db.VarChar(100)
  rapportino_id  String    @db.Uuid
  storage_key    String    @db.VarChar(512)
  bucket         String    @default("rapportini-active") @db.VarChar(100)
  mime_type      String    @db.VarChar(100)
  size_bytes     BigInt?
  caption        String?
  uploaded_by    String?   @db.Uuid
  archived_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)

  rapportini Rapportini @relation(fields: [rapportino_id], references: [id], onDelete: Cascade)

  @@index([rapportino_id], map: "idx_rapportino_immagini_rapportino")
  @@index([org_id], map: "idx_rapportino_immagini_org")
  @@index([archived_at, created_at], map: "idx_rapportino_immagini_archive")
  @@map("rapportino_immagini")
}

model Organizzazioni {
  org_id        String    @id @db.VarChar(100)
  nome_azienda  String?   @db.VarChar(255)
  logo          String?
  indirizzo     String?   @db.VarChar(500)
  partita_iva   String?   @db.VarChar(50)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@map("organizzazioni")
}

model PasswordResetTokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique @db.VarChar(64)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  utenti Utenti @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_password_reset_tokens_user_id")
  @@index([token], map: "idx_password_reset_tokens_token")
  @@index([expires_at], map: "idx_password_reset_tokens_expires")
  @@map("password_reset_tokens")
}

model Marche {
  id         String    @id @default(uuid()) @db.Uuid
  org_id     String    @default("default") @db.VarChar(100)
  nome       String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  modelli Modelli[]

  @@unique([org_id, nome])
  @@index([nome], map: "idx_marche_nome")
  @@index([org_id], map: "idx_marche_org_id")
  @@map("marche")
}

model Modelli {
  id         String    @id @default(uuid()) @db.Uuid
  org_id     String    @default("default") @db.VarChar(100)
  marca_id   String    @db.Uuid
  nome       String    @db.VarChar(200)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  marche     Marche      @relation(fields: [marca_id], references: [id], onDelete: Cascade)
  materiali Materiali[]

  @@unique([org_id, marca_id, nome])
  @@index([marca_id], map: "idx_modelli_marca")
  @@index([org_id], map: "idx_modelli_org_id")
  @@map("modelli")
}

model Materiali {
  id          String    @id @default(uuid()) @db.Uuid
  org_id      String    @default("default") @db.VarChar(100)
  modello_id  String    @db.Uuid
  nome        String    @db.VarChar(200)
  descrizione String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  modelli Modelli @relation(fields: [modello_id], references: [id], onDelete: Cascade)

  @@unique([org_id, modello_id, nome])
  @@index([modello_id], map: "idx_materiali_modello")
  @@index([org_id], map: "idx_materiali_org_id")
  @@map("materiali")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  org_id     String   @default("default") @db.VarChar(100)
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(64)
  resource   String?  @db.VarChar(128)
  details    Json?
  ip         String?  @db.VarChar(64)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([org_id, created_at(sort: Desc)])
  @@index([user_id])
  @@map("audit_log")
}
